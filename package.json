{
  "name": "prefkeeper",
  "version": "0.1.0",
  "description": "A drop-in accessibility preference engine — users set color, text, and motion preferences once on their device; any site using PrefKeeper reads and applies them automatically.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "postbuild": "node scripts/copy-assets.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "accessibility",
    "a11y",
    "theme",
    "preferences",
    "wcag"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbatchelder/prefkeeper.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/tbatchelder/prefkeeper/issues"
  },
  "homepage": "https://github.com/tbatchelder/prefkeeper#readme"
}
